{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "static-assets": {
      "root": "public",
      "outputDirectory": "."
    },
    "backend-laravel": {
      "root": ".",
      "entrypoint": "Dockerfile",
      "runtime": "container"
    }
  },
  "rewrites": [
    {
      "source": "/build/assets/(.*)",
      "destination": {
        "service": "static-assets"
      }
    },
    {
      "source": "/css/(.*)",
      "destination": {
        "service": "static-assets"
      }
    },
    {
      "source": "/vendor/livewire/(.*)",
      "destination": {
        "service": "static-assets"
      }
    },
    {
      "source": "/favicon.ico",
      "destination": {
        "service": "static-assets"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "backend-laravel"
      }
    }
  ]
}