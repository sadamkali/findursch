APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production Vercel: APP_URL=https://findurschool.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Production on Vercel uses Supabase PostgreSQL. The container defaults to
# DB_CONNECTION=pgsql and DB_SSLMODE=require. Add the actual URL as a secret
# in Vercel (DB_URL, DATABASE_URL, or POSTGRES_URL); never commit credentials.
# DB_CONNECTION=pgsql
# DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Filebase S3-compatible storage. Create a public bucket for public school
# images, then set MEDIA_DISK=filebase in Vercel after adding these secrets.
# Never commit real access keys to this file or to GitHub.
# Default to Cloudflare R2 for public media uploads. Set to filebase only when using Filebase.
MEDIA_DISK=r2
FILEBASE_KEY=
FILEBASE_SECRET=
FILEBASE_BUCKET=
FILEBASE_REGION=auto
FILEBASE_ENDPOINT=https://s3.filebase.io
# Public object URL base, e.g. https://YOUR_BUCKET.s3.filebase.io
FILEBASE_URL=
FILEBASE_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2. Use MEDIA_DISK=r2 in Preview and Production after the R2 bucket is configured.
# Keep Filebase variables temporarily for rollback; do not remove the old bucket until migration checks pass.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=findursch
R2_REGION=auto
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<PUBLIC_BUCKET_ID>.r2.dev

VITE_APP_NAME="${APP_NAME}"
