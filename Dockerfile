# Vercel Container Runtime: Laravel 12 + FrankenPHP
FROM dunglas/frankenphp:1-php8.3 AS php-base

RUN install-php-extensions \
    pdo_pgsql \
    gd \
    intl \
    zip \
    exif \
    pcntl \
    posix \
    opcache

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /app

FROM php-base AS vendor
COPY composer.json composer.lock ./
# Resolve and install the S3 adapter and its AWS SDK dependencies against
# the committed dependency set. This produces an updated lock file in the
# build image, because the repository lock predates Filebase support.
RUN composer update league/flysystem-aws-s3-v3 aws/aws-sdk-php \
    --with-dependencies \
    --no-dev \
    --no-interaction \
    --no-progress \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts \
    && composer show league/flysystem-aws-s3-v3 --no-interaction

FROM node:22-alpine AS frontend
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY resources ./resources
COPY vite.config.js ./
COPY public ./public
RUN npm run build

FROM php-base AS runtime
WORKDIR /app

COPY . .
COPY --from=vendor /app/vendor ./vendor
# Carry the dependency lock generated by the vendor stage into the runtime image.
COPY --from=vendor /app/composer.lock ./composer.lock
COPY --from=frontend /app/public/build ./public/build
COPY Caddyfile /etc/caddy/Caddyfile
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint

RUN chmod +x /usr/local/bin/docker-entrypoint \
    && mkdir -p \
      storage/framework/cache \
      storage/framework/sessions \
      storage/framework/views \
      storage/logs \
      bootstrap/cache \
    && composer dump-autoload --no-dev --optimize --no-interaction --no-scripts \
    && php artisan package:discover --ansi \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R ug+rwx storage bootstrap/cache

ENV APP_NAME="FindurSch" \
    APP_ENV=production \
    APP_DEBUG=false \
    DB_CONNECTION=pgsql \
    DB_SSLMODE=require \
    SESSION_DRIVER=database \
    CACHE_STORE=database \
    QUEUE_CONNECTION=database \
    LOG_CHANNEL=stderr \
    LOG_LEVEL=warning \
    SERVER_NAME=:80

EXPOSE 80
ENTRYPOINT ["/usr/local/bin/docker-entrypoint"]
